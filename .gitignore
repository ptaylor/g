# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / IDE — ignore local state, keep shareable config committable
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Local environment and per-user overrides
.env
.env.local
*.local

# g's cross-repository index: a regenerable cache, and it lands in whichever
# directory g grep is first run from
.g-repos

# Logs, caches and temporary files
*.log
*.tmp
tmp/
.cache/
